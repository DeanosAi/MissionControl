POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mission_control:change-me@localhost:5432/mission_control
ADMIN_EMAIL=Dean.j.brady@hotmail.com
ADMIN_PASSWORD_HASH=$2b$10$xf08X9r/M5yPLEENr757p.PjF0GPjnbG/itNae/HMVXZiJVKOku1q
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# OpenAI OAuth Endpoint (PREFERRED - uses ChatGPT subscription via SSH tunnel, no API credits)
# With the SSH reverse tunnel running, the proxy is reachable at localhost:3001
# Start the tunnel on your Windows PC: .\scripts\start-gpt-oauth.ps1
OPENAI_OAUTH_ENDPOINT=http://localhost:3001/chat

# OpenAI API Key (FALLBACK - uses API credits when OAuth proxy is unavailable)
# Only needed if you want GPT without the tunnel. Otherwise leave blank.
OPENAI_API_KEY=

# Backup status file path (optional - defaults shown)
# BACKUP_STATUS_PATH=/home/dean/backups/mission-control/backup-status.json

# Anthropic API Key for Claude models in Chat
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Moonshot API Key for Kimi models in Chat
# Get your key from: https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=your-moonshot-api-key-here

# ── v2: Google Workspace Integration (Milestone I) ──
# Create OAuth2 credentials at https://console.cloud.google.com
# Enable: Drive API, Gmail API, Docs API, Sheets API, Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.missioncontroldb.online/api/google/callback

# ── v2: N8N Workflow Integration (Milestone L) ──
# Install N8N: docker run -p 5678:5678 n8nio/n8n
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
AUTOMATION_TICK_TOKEN=
RESEARCH_SOURCE_URLS=
